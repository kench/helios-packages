# BELABOX's gstreamer-rockchip (LGPL-2.1): the Rockchip MPP GStreamer elements (mpph264enc,
# mpph265enc, mppvideodec, mppjpegdec...) that belacoder and ceracoder drive, for the RK3588
# (Orange Pi 5 Plus) on Armbian Trixie with the vendor kernel. Rockchip MPP and librga are linked
# in statically, from the same commits as helios-ffmpeg-rk3588. Installed in a private plugin
# directory (Helios's [modules.stream] gst_plugin_path), so nothing else on the board loads it.
# Upstream has no releases: VERSION is the meson version, the commit date and hash. Bump
# UPSTREAM_COMMIT and UPSTREAM_DATE together, and reset the Debian revision to -1; bump only the
# revision for packaging changes. The release tag is helios-gst-rockchip-rk3588/$VERSION.
NAME=helios-gst-rockchip-rk3588
VERSION=1.14.4+git20260118.6453290-1
UPSTREAM_REPO=https://github.com/BELABOX/gstreamer-rockchip.git
UPSTREAM_COMMIT=6453290d26121659111ce3d444ec33624de7506a
SUITE=trixie
COMPONENT=rk3588
ARCH=arm64
BUILD_RUNNER=ubuntu-24.04-arm
BUILD_CONTAINER=debian:trixie@sha256:9c6e381421d0f48d1b8133e573f33c185ee16cbf505eda9c4a8a4791b25ea8a6
BUILD_DEPS="build-essential pkg-config git ca-certificates cmake ninja-build meson dpkg-dev xz-utils
    libdrm-dev libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev gstreamer1.0-tools"
MPP_REPO=https://github.com/nyanmisaka/rk-mirrors.git
MPP_COMMIT=848b885f95587994a53216e435f650041a894e31
RGA_REPO=https://github.com/nyanmisaka/rk-mirrors.git
RGA_COMMIT=1d330cc28551943bed3380261a5a9c6fbd58ff53
CPU=cortex-a76.cortex-a55
# Where the plugin goes: GST_PLUGIN_PATH for belacoder and ceracoder.
PLUGIN_DIR=/usr/lib/helios-gst/gstreamer-1.0
