From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: helios-packages <helios-packages@invalid>
Date: Sat, 21 Nov 2026 21:16:21 -0800
Subject: [PATCH 1/2] Add -p to set the SRT passphrase

Sets SRTO_PASSPHRASE on the SRT socket before each connection (the first
and in-process reconnects), for listeners that require encryption. libsrt
accepts 10 to 79 characters; the option checks that up front.
---
 src/ceracoder.c      |  1 +
 src/io/cli_options.c | 11 ++++++++++-
 src/io/cli_options.h |  1 +
 src/net/srt_client.c | 15 +++++++++++++++
 src/net/srt_client.h |  6 ++++++
 5 files changed, 33 insertions(+), 1 deletion(-)

diff --git a/src/ceracoder.c b/src/ceracoder.c
index 9d8f53a..e318b33 100644
--- a/src/ceracoder.c
+++ b/src/ceracoder.c
@@ -740,6 +740,7 @@ int main(int argc, char** argv) {
   srt_host = opts.srt_host;
   srt_port = opts.srt_port;
   srt_stream_id = opts.stream_id;
+  srt_client_set_passphrase(opts.passphrase);
   srt_latency_ms = srt_latency;
   unsigned int rc_base = (unsigned int)env_long("CERACODER_RECONNECT_BASE_MS",
                                                 RECONNECT_DEFAULT_BASE_MS, 1, 600000);
diff --git a/src/io/cli_options.c b/src/io/cli_options.c
index 91f34a5..aa5c16b 100644
--- a/src/io/cli_options.c
+++ b/src/io/cli_options.c
@@ -62,6 +62,7 @@ void cli_options_print_usage(void) {
     fprintf(stderr, "  -c <config file>    Configuration file (INI format)\n");
     fprintf(stderr, "  -d <delay>          Audio-video delay in milliseconds\n");
     fprintf(stderr, "  -s <streamid>       SRT stream ID\n");
+    fprintf(stderr, "  -p <passphrase>     SRT passphrase (10 to 79 characters)\n");
     fprintf(stderr, "  -l <latency>        SRT latency in milliseconds\n");
     fprintf(stderr, "  -r                  Reduced SRT packet size\n");
     fprintf(stderr, "  -b <bitrate file>   Bitrate settings file (legacy, use -c instead)\n");
@@ -84,7 +85,7 @@ int cli_options_parse(CliOptions *opts, int argc, char **argv) {
     opts->reduced_pkt_size = 0;
 
     int opt;
-    while ((opt = getopt(argc, argv, "a:c:d:b:s:l:rv")) != -1) {
+    while ((opt = getopt(argc, argv, "a:c:d:b:s:p:l:rv")) != -1) {
         switch (opt) {
             case 'a':
                 opts->balancer_name = optarg;
@@ -108,6 +109,14 @@ int cli_options_parse(CliOptions *opts, int argc, char **argv) {
             case 's':
                 opts->stream_id = optarg;
                 break;
+            case 'p':
+                if (strlen(optarg) < 10 || strlen(optarg) > 79) {
+                    fprintf(stderr, "The SRT passphrase must be 10 to 79 characters\n\n");
+                    cli_options_print_usage();
+                    exit(EXIT_FAILURE);
+                }
+                opts->passphrase = optarg;
+                break;
             case 'l': {
                 long latency;
                 if (parse_long(optarg, &latency, MIN_SRT_LATENCY, MAX_SRT_LATENCY) != 0) {
diff --git a/src/io/cli_options.h b/src/io/cli_options.h
index 05dcb86..0bc8e77 100644
--- a/src/io/cli_options.h
+++ b/src/io/cli_options.h
@@ -39,6 +39,7 @@ typedef struct {
     char *balancer_name;       // Overrides config
     char *bitrate_file;        // Legacy, overrides config
     char *stream_id;           // SRT stream identifier
+    char *passphrase;          // SRT passphrase (NULL: no encryption)
     int srt_latency;           // SRT latency in ms
     int av_delay;              // Audio-video delay in ms
     int reduced_pkt_size;      // Use reduced SRT packet size (bool)
diff --git a/src/net/srt_client.c b/src/net/srt_client.c
index e7030c9..d8d7dd1 100644
--- a/src/net/srt_client.c
+++ b/src/net/srt_client.c
@@ -27,6 +27,12 @@ void srt_client_init(void) {
     srt_startup();
 }
 
+static const char *srt_passphrase = NULL;
+
+void srt_client_set_passphrase(const char *passphrase) {
+    srt_passphrase = passphrase;
+}
+
 int srt_client_connect(SrtClient *client, const char *host, const char *port,
                        const char *stream_id, int latency, int pkt_size) {
     struct addrinfo hints;
@@ -78,6 +84,15 @@ int srt_client_connect(SrtClient *client, const char *host, const char *port,
         }
     }
 
+    if (srt_passphrase != NULL) {
+        if (srt_setsockflag(client->socket, SRTO_PASSPHRASE, srt_passphrase,
+                            (int)strlen(srt_passphrase)) != 0) {
+            fprintf(stderr, "Failed to set SRTO_PASSPHRASE: %s\n", srt_getlasterror_str());
+            freeaddrinfo(addrs);
+            return -4;
+        }
+    }
+
     int32_t algo = 1;
     if (srt_setsockflag(client->socket, SRTO_RETRANSMITALGO, &algo, sizeof(algo)) != 0) {
         fprintf(stderr, "Failed to set SRTO_RETRANSMITALGO: %s\n", srt_getlasterror_str());
diff --git a/src/net/srt_client.h b/src/net/srt_client.h
index f35dd6a..fbf5a79 100644
--- a/src/net/srt_client.h
+++ b/src/net/srt_client.h
@@ -49,6 +49,12 @@ void srt_client_init(void);
  *
  * Returns 0 on success, < 0 on error
  */
+/*
+ * Sets the passphrase later connections use (SRTO_PASSPHRASE), or none with NULL.
+ * The string must outlive the connections.
+ */
+void srt_client_set_passphrase(const char *passphrase);
+
 int srt_client_connect(SrtClient *client, const char *host, const char *port,
                        const char *stream_id, int latency, int pkt_size);
 
-- 
2.47.3

