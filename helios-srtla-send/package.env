# irlserver srtla_send (MIT), the SRTLA bonding sender (HLD 6.4: video.srtla.sender = "irlserver").
# Bump UPSTREAM_TAG and UPSTREAM_COMMIT together, and reset the Debian revision to -1; bump only
# the revision for packaging changes. The release tag is helios-srtla-send/$VERSION.
NAME=helios-srtla-send
VERSION=4.1.0-1
UPSTREAM_REPO=https://github.com/irlserver/srtla_send.git
UPSTREAM_TAG=v4.1.0
UPSTREAM_COMMIT=329982543dccda9ca9b99b2b90d1499fd452a7bf
SUITE=trixie
COMPONENT=main
ARCH=arm64
TARGET=aarch64-unknown-linux-gnu
# The oldest glibc the boards may run; the package depends on libc6 (>= this).
GLIBC=2.31

# Built on the host (ubuntu-24.04) with cargo zigbuild.
BUILD_TOOLS=zigbuild
