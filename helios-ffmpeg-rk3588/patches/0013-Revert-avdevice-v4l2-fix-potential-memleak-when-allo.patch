From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nyanmisaka <nst799610810@gmail.com>
Date: Sun, 25 Oct 2026 21:43:38 +0800
Subject: [PATCH 13/19] Revert "avdevice/v4l2: fix potential memleak when
 allocating device buffers"

This reverts commit 24adcf3a72d88e1b38360678e3331eeb6de6849c.
---
 libavdevice/v4l2.c | 30 ++++++++++--------------------
 1 file changed, 10 insertions(+), 20 deletions(-)

diff --git a/libavdevice/v4l2.c b/libavdevice/v4l2.c
index a4122c452f..c38ecbb378 100644
--- a/libavdevice/v4l2.c
+++ b/libavdevice/v4l2.c
@@ -356,15 +356,6 @@ static void list_standards(AVFormatContext *ctx)
     }
 }
 
-static void mmap_free(struct video_data *s, int n)
-{
-    while (--n > 0) {
-        v4l2_munmap(s->buf_start[n], s->buf_len[n]);
-    }
-    av_freep(&s->buf_start);
-    av_freep(&s->buf_len);
-}
-
 static int mmap_init(AVFormatContext *ctx)
 {
     int i, res;
@@ -411,14 +402,13 @@ static int mmap_init(AVFormatContext *ctx)
         if (v4l2_ioctl(s->fd, VIDIOC_QUERYBUF, &buf) < 0) {
             res = AVERROR(errno);
             av_log(ctx, AV_LOG_ERROR, "ioctl(VIDIOC_QUERYBUF): %s\n", av_err2str(res));
-            goto fail;
+            return res;
         }
 
         if (s->multiplanar) {
             if (buf.length != 1) {
                 av_log(ctx, AV_LOG_ERROR, "multiplanar only supported when buf.length == 1\n");
-                res = AVERROR_PATCHWELCOME;
-                goto fail;
+                return AVERROR_PATCHWELCOME;
             }
             buf_length = buf.m.planes[0].length;
             buf_offset = buf.m.planes[0].m.mem_offset;
@@ -432,8 +422,7 @@ static int mmap_init(AVFormatContext *ctx)
             av_log(ctx, AV_LOG_ERROR,
                    "buf_len[%d] = %d < expected frame size %d\n",
                    i, s->buf_len[i], s->frame_size);
-            res = AVERROR(ENOMEM);
-            goto fail;
+            return AVERROR(ENOMEM);
         }
         s->buf_start[i] = v4l2_mmap(NULL, buf_length,
                                PROT_READ | PROT_WRITE, MAP_SHARED,
@@ -442,15 +431,11 @@ static int mmap_init(AVFormatContext *ctx)
         if (s->buf_start[i] == MAP_FAILED) {
             res = AVERROR(errno);
             av_log(ctx, AV_LOG_ERROR, "mmap: %s\n", av_err2str(res));
-            goto fail;
+            return res;
         }
     }
 
     return 0;
-
-fail:
-    mmap_free(s, i);
-    return res;
 }
 
 static int enqueue_buffer(struct video_data *s, struct v4l2_buffer *buf)
@@ -696,13 +681,18 @@ static int mmap_start(AVFormatContext *ctx)
 static void mmap_close(struct video_data *s)
 {
     enum v4l2_buf_type type;
+    int i;
 
     type = s->buf_type;
     /* We do not check for the result, because we could
      * not do anything about it anyway...
      */
     v4l2_ioctl(s->fd, VIDIOC_STREAMOFF, &type);
-    mmap_free(s, s->buffers);
+    for (i = 0; i < s->buffers; i++) {
+        v4l2_munmap(s->buf_start[i], s->buf_len[i]);
+    }
+    av_freep(&s->buf_start);
+    av_freep(&s->buf_len);
 }
 
 static int v4l2_set_parameters(AVFormatContext *ctx)
