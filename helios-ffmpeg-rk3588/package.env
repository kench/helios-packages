# helios-ffmpeg-rk3588: FFmpeg with Rockchip MPP (hardware video decode/encode) and RGA (hardware
# scale, crop, convert, overlay) for RK3588 boards on Armbian Trixie with the vendor kernel.
NAME=helios-ffmpeg-rk3588
VERSION=9.0.2-1
SUITE=trixie
COMPONENT=rk3588
ARCH=arm64

# Built natively on GitHub's arm64 runners, in Debian Trixie (the index digest of debian:trixie).
BUILD_RUNNER=ubuntu-24.04-arm
BUILD_CONTAINER=debian:trixie@sha256:9c6e381421d0f48d1b8133e573f33c185ee16cbf505eda9c4a8a4791b25ea8a6
BUILD_DEPS="build-essential pkg-config git ca-certificates cmake ninja-build meson dpkg-dev xz-utils
    libdrm-dev libx264-dev libsrt-gnutls-dev libgnutls28-dev zlib1g-dev"

# FFmpeg n9.0.2, with patches/ applied: nyanmisaka/ffmpeg-rockchip's 19 commits on top of
# FFmpeg's release/9.0 branch at FORK_COMMIT (exported with git format-patch). They apply
# unchanged to n9.0.2.
UPSTREAM_REPO=https://github.com/FFmpeg/FFmpeg.git
UPSTREAM_TAG=n9.0.2
UPSTREAM_COMMIT=946fcce07b6dcd0331c8cc609192aeff5e1924f8
FORK_REPO=https://github.com/nyanmisaka/ffmpeg-rockchip.git
FORK_BRANCH=9.0
FORK_COMMIT=12b8e9618e98783542cf0136f57e0011c9c6090c

# Linked statically into FFmpeg, at the commits jellyfin-ffmpeg builds with
# (builder/scripts.d/50-rkmpp.sh and 50-rkrga.sh): MPP 1.3.9 (Apache-2.0 and MIT) and librga
# 2.1.0 (Apache-2.0), from nyanmisaka/rk-mirrors' jellyfin-mpp-next and jellyfin-rga-next.
MPP_REPO=https://github.com/nyanmisaka/rk-mirrors.git
MPP_COMMIT=848b885f95587994a53216e435f650041a894e31
RGA_REPO=https://github.com/nyanmisaka/rk-mirrors.git
RGA_COMMIT=1d330cc28551943bed3380261a5a9c6fbd58ff53

# The CPU: 4x Cortex-A76 + 4x Cortex-A55 (README: "FFmpeg build flags").
CPU=cortex-a76.cortex-a55
PREFIX=/usr/lib/helios-ffmpeg
