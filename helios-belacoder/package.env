# BELABOX's belacoder (GPL-3.0): a GStreamer-based live encoder that sends over SRT and adapts the video
# bitrate to the link (LLD 4, adaptive bitrate; driven by Helios's stream module, encoder =
# "belacoder"). With patches/ adding -p for an SRT passphrase. Upstream has no releases: VERSION is
# the commit date and hash. Bump UPSTREAM_COMMIT (and CAMLINK_COMMIT, the camlink_workaround
# submodule it pins) together, and reset the Debian revision to -1; bump only the revision for
# packaging changes. The release tag is helios-belacoder/$VERSION.
# helios-belacoder/build.sh and helios-ceracoder/build.sh are the same file: keep them identical.
NAME=helios-belacoder
PROGRAM=belacoder
VERSION=0.0+git20261011.6588b6b-1
UPSTREAM_REPO=https://github.com/BELABOX/belacoder.git
UPSTREAM_COMMIT=6588b6bddc3e0aed2eefe9506423e6f6057370c3
CAMLINK_REPO=https://github.com/BELABOX/camlink.git
CAMLINK_COMMIT=a46a8867449cba39ded7a4bbbe2c3a8fcf5c14a8
# The bitrate range file: two lines in bps (-b), or an INI in kbps (-c).
RANGE=bps
SUITE=trixie
COMPONENT=main
ARCH=arm64
BUILD_RUNNER=ubuntu-24.04-arm
BUILD_CONTAINER=debian:trixie@sha256:9c6e381421d0f48d1b8133e573f33c185ee16cbf505eda9c4a8a4791b25ea8a6
BUILD_DEPS="build-essential pkg-config git ca-certificates dpkg-dev xz-utils
    libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev libsrt-gnutls-dev
    srt-tools gstreamer1.0-plugins-base gstreamer1.0-plugins-good gstreamer1.0-plugins-bad
    gstreamer1.0-plugins-ugly"
